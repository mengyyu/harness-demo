# ── LLM Configuration ────────────────────────────────────
# Provider: anthropic | openai | google_genai | mock
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_TEMPERATURE=0.1
LLM_API_KEY=your_api_key_here
LLM_MAX_TOKENS=4096

# ── LangFuse (Observability) ──────────────────────────────
# Set LANGFUSE_ENABLED=true and provide keys to enable tracing
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Mem0 (Memory) ─────────────────────────────────────────
# Set MEM0_ENABLED=true to use Mem0 for persistent memory
MEM0_ENABLED=false
MEM0_VECTOR_STORE=chroma
MEM0_LLM_PROVIDER=langchain
MEM0_EMBEDDER_PROVIDER=langchain

# ── Database ──────────────────────────────────────────────
# SQLite for development (default)
DATABASE_URL=sqlite:///./data/harness.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://harness:password@localhost:5432/harness
DATABASE_ECHO=false

# ── MCP ───────────────────────────────────────────────────
MCP_CONFIG_PATH=config/mcp_servers.yaml
MCP_DEFAULT_TIMEOUT=30

# ── Agent Loop ────────────────────────────────────────────
AGENT_MAX_ITERATIONS=25
AGENT_RECURSION_LIMIT=50
AGENT_INTERRUPT_ENABLED=true
AGENT_DEFAULT_MODEL=anthropic:claude-sonnet-4-5-20250929
AGENT_MAX_LOOPS=5
AGENT_TIMEOUT_SECONDS=300

# ── API Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_PORT=8501

# ── Memory Limits ─────────────────────────────────────────
MEMORY_MAX_SESSION=100
MEMORY_MAX_USER=500
MEMORY_MAX_ENTITY=1000

# ── Debug ─────────────────────────────────────────────────
DEBUG=false
